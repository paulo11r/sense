[gd_scene format=3]

[ext_resource type="FontVariation" path="res://fontes/Body.tres" id="1"]
[ext_resource type="FontVariation" path="res://fontes/Heading.tres" id="2"]
[ext_resource type="FontVariation" path="res://fontes/Medium.tres" id="3"]
[ext_resource type="Script" path="res://scripts/ResultFinal.gd" id="4"]
[ext_resource type="Texture2D" path="res://recursos/ui/arrow-left.svg" id="5"]
[ext_resource type="Texture2D" path="res://recursos/ui/accessibility.svg" id="6"]
[ext_resource type="Texture2D" path="res://recursos/openmoji/1F60C.svg" id="7"]
[ext_resource type="Texture2D" path="res://recursos/ui/volume-2-white.svg" id="8"]
[ext_resource type="Texture2D" path="res://recursos/ui/rotate-ccw.svg" id="9"]

[node name="ResultsFinal" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("4")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.98039, 0.96863, 0.94902, 1)

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
theme_override_constants/margin_left = 56
theme_override_constants/margin_top = 56
theme_override_constants/margin_right = 56
theme_override_constants/margin_bottom = 56
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 32

[node name="Header" type="HBoxContainer" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="BackButton" type="Button" parent="MarginContainer/Content/Header"]
layout_mode = 2
custom_minimum_size = Vector2(100, 100)
text = ""
theme_override_font_sizes/font_size = 38
icon = ExtResource("5")
expand_icon = true
theme_override_constants/icon_max_width = 42
theme_override_constants/h_separation = 20

[node name="Title" type="Label" parent="MarginContainer/Content/Header"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 34
theme_override_colors/font_color = Color(0.18824, 0.14902, 0.24706, 1)
text = "SUA ESCOLHA"
mouse_filter = 2
size_flags_horizontal = 3
vertical_alignment = 1
horizontal_alignment = 1

[node name="AcessibilityButton" type="Button" parent="MarginContainer/Content/Header"]
layout_mode = 2
custom_minimum_size = Vector2(100, 100)
text = ""
theme_override_font_sizes/font_size = 38
icon = ExtResource("6")
expand_icon = true
theme_override_constants/icon_max_width = 42
theme_override_constants/h_separation = 20

[node name="Step" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 26
theme_override_colors/font_color = Color(0.48235, 0.35294, 0.7098, 1)
text = "OBRIGADO POR COMPARTILHAR"
mouse_filter = 2

[node name="Subtitle" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 82
theme_override_colors/font_color = Color(0.18824, 0.14902, 0.24706, 1)
text = "Tudo bem\nsentir isso."
mouse_filter = 2
autowrap_mode = 2
size_flags_horizontal = 3

[node name="Helper" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_fonts/font = ExtResource("1")
theme_override_font_sizes/font_size = 34
theme_override_colors/font_color = Color(0.45882, 0.40784, 0.50196, 1)
text = "Você pode mostrar esta tela para alguém."
mouse_filter = 2
autowrap_mode = 2
size_flags_horizontal = 3

[node name="ResultCard" type="PanelContainer" parent="MarginContainer/Content"]
layout_mode = 2
size_flags_vertical = 3

[node name="CardContent" type="VBoxContainer" parent="MarginContainer/Content/ResultCard"]
layout_mode = 2
theme_override_constants/separation = 24
alignment = 1

[node name="TextureRect" type="TextureRect" parent="MarginContainer/Content/ResultCard/CardContent"]
texture_filter = 2
layout_mode = 2
custom_minimum_size = Vector2(300, 300)
texture = ExtResource("7")
expand_mode = 1
stretch_mode = 5
mouse_filter = 2

[node name="NomeLabel" type="Label" parent="MarginContainer/Content/ResultCard/CardContent"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 76
theme_override_colors/font_color = Color(0.18824, 0.14902, 0.24706, 1)
text = "Calmo"
mouse_filter = 2
horizontal_alignment = 1
autowrap_mode = 2
size_flags_horizontal = 3

[node name="PanelContainer" type="PanelContainer" parent="MarginContainer/Content/ResultCard/CardContent"]
layout_mode = 2

[node name="TagLabel" type="Label" parent="MarginContainer/Content/ResultCard/CardContent/PanelContainer"]
layout_mode = 2
theme_override_fonts/font = ExtResource("1")
theme_override_font_sizes/font_size = 30
theme_override_colors/font_color = Color(0.38431, 0.32549, 0.4549, 1)
text = "É assim que eu me sinto agora."
mouse_filter = 2
horizontal_alignment = 1
autowrap_mode = 2
size_flags_horizontal = 3

[node name="ActionButtons" type="VBoxContainer" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="RetryButton" type="Button" parent="MarginContainer/Content/ActionButtons"]
layout_mode = 2
custom_minimum_size = Vector2(0, 120)
text = "Ouvir minha escolha"
theme_override_font_sizes/font_size = 38
icon = ExtResource("8")
expand_icon = true
theme_override_constants/icon_max_width = 42
theme_override_constants/h_separation = 20

[node name="PlayAgainButton" type="Button" parent="MarginContainer/Content/ActionButtons"]
layout_mode = 2
custom_minimum_size = Vector2(0, 110)
text = "Escolher novamente"
theme_override_font_sizes/font_size = 38
icon = ExtResource("9")
expand_icon = true
theme_override_constants/icon_max_width = 42
theme_override_constants/h_separation = 20

[node name="Instruction" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_fonts/font = ExtResource("1")
theme_override_font_sizes/font_size = 29
theme_override_colors/font_color = Color(0.45882, 0.40784, 0.50196, 1)
text = "Se precisar, peça ajuda a alguém de confiança."
mouse_filter = 2
horizontal_alignment = 1
autowrap_mode = 2
size_flags_horizontal = 3

[connection signal="pressed" from="MarginContainer/Content/Header/AcessibilityButton" to="." method="_on_accessibility_pressed"]
