[gd_scene format=3]

[ext_resource type="FontVariation" path="res://fontes/Body.tres" id="1"]
[ext_resource type="FontVariation" path="res://fontes/Heading.tres" id="2"]
[ext_resource type="FontVariation" path="res://fontes/Medium.tres" id="3"]
[ext_resource type="Script" path="res://scripts/Feelings.gd" id="4"]
[ext_resource type="Texture2D" path="res://recursos/ui/arrow-left.svg" id="5"]
[ext_resource type="Texture2D" path="res://recursos/ui/accessibility.svg" id="6"]
[ext_resource type="PackedScene" path="res://cenas/componentes/FeelingsCard.tscn" id="7"]
[ext_resource type="Texture2D" path="res://recursos/openmoji/1F60C.svg" id="8"]
[ext_resource type="Texture2D" path="res://recursos/openmoji/1F623.svg" id="9"]
[ext_resource type="Texture2D" path="res://recursos/openmoji/1F628.svg" id="10"]
[ext_resource type="Texture2D" path="res://recursos/openmoji/1F622.svg" id="11"]
[ext_resource type="Texture2D" path="res://recursos/openmoji/1F922.svg" id="12"]
[ext_resource type="Texture2D" path="res://recursos/openmoji/1F62B.svg" id="13"]

[node name="Feelings" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("4")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.98039, 0.96863, 0.94902, 1)

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
theme_override_constants/margin_left = 56
theme_override_constants/margin_top = 56
theme_override_constants/margin_right = 56
theme_override_constants/margin_bottom = 56
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 28

[node name="Header" type="HBoxContainer" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="BackButton" type="Button" parent="MarginContainer/Content/Header"]
layout_mode = 2
custom_minimum_size = Vector2(100, 100)
text = ""
theme_override_font_sizes/font_size = 38
icon = ExtResource("5")
expand_icon = true
theme_override_constants/icon_max_width = 42
theme_override_constants/h_separation = 20

[node name="Title" type="Label" parent="MarginContainer/Content/Header"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 34
theme_override_colors/font_color = Color(0.18824, 0.14902, 0.24706, 1)
text = "SEUS SENTIMENTOS"
mouse_filter = 2
size_flags_horizontal = 3
vertical_alignment = 1
horizontal_alignment = 1

[node name="AcessibilityButton" type="Button" parent="MarginContainer/Content/Header"]
layout_mode = 2
custom_minimum_size = Vector2(100, 100)
text = ""
theme_override_font_sizes/font_size = 38
icon = ExtResource("6")
expand_icon = true
theme_override_constants/icon_max_width = 42
theme_override_constants/h_separation = 20

[node name="Step" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 26
theme_override_colors/font_color = Color(0.48235, 0.35294, 0.7098, 1)
text = "VAMOS CONVERSAR"
mouse_filter = 2

[node name="Subtitle" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 70
theme_override_colors/font_color = Color(0.18824, 0.14902, 0.24706, 1)
text = "Como você está\nse sentindo agora?"
mouse_filter = 2
autowrap_mode = 2
size_flags_horizontal = 3

[node name="Helper" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_fonts/font = ExtResource("1")
theme_override_font_sizes/font_size = 32
theme_override_colors/font_color = Color(0.45882, 0.40784, 0.50196, 1)
text = "Escolha a imagem que mais combina com você."
mouse_filter = 2
autowrap_mode = 2
size_flags_horizontal = 3

[node name="FeelingsGrid" type="GridContainer" parent="MarginContainer/Content"]
layout_mode = 2
size_flags_vertical = 3
columns = 2
theme_override_constants/h_separation = 24
theme_override_constants/v_separation = 24

[node name="FeelingsCard" parent="MarginContainer/Content/FeelingsGrid" instance=ExtResource("7")]
layout_mode = 2
feeling_name = "Calmo"
feeling_description = "Tranquilo e à vontade"
feeling_icon = ExtResource("8")
card_color = Color(0.90588, 0.9451, 0.92549, 1)
accent_color = Color(0.19608, 0.41961, 0.33725, 1)

[node name="FeelingsCard2" parent="MarginContainer/Content/FeelingsGrid" instance=ExtResource("7")]
layout_mode = 2
feeling_name = "Com dor"
feeling_description = "Algo está doendo"
feeling_icon = ExtResource("9")
card_color = Color(0.98039, 0.91373, 0.88627, 1)
accent_color = Color(0.63137, 0.3098, 0.23529, 1)

[node name="FeelingsCard3" parent="MarginContainer/Content/FeelingsGrid" instance=ExtResource("7")]
layout_mode = 2
feeling_name = "Com medo"
feeling_description = "Assustado ou inseguro"
feeling_icon = ExtResource("10")
card_color = Color(0.93333, 0.9098, 0.96863, 1)
accent_color = Color(0.43922, 0.32549, 0.61961, 1)

[node name="FeelingsCard4" parent="MarginContainer/Content/FeelingsGrid" instance=ExtResource("7")]
layout_mode = 2
feeling_name = "Triste"
feeling_description = "Desanimado, sem alegria"
feeling_icon = ExtResource("11")
card_color = Color(0.90588, 0.93333, 0.97255, 1)
accent_color = Color(0.2549, 0.41176, 0.59216, 1)

[node name="FeelingsCard5" parent="MarginContainer/Content/FeelingsGrid" instance=ExtResource("7")]
layout_mode = 2
feeling_name = "Enjoado"
feeling_description = "Vontade de vomitar"
feeling_icon = ExtResource("12")
card_color = Color(0.93333, 0.94118, 0.87451, 1)
accent_color = Color(0.38039, 0.43922, 0.22353, 1)

[node name="FeelingsCard6" parent="MarginContainer/Content/FeelingsGrid" instance=ExtResource("7")]
layout_mode = 2
feeling_name = "Cansado"
feeling_description = "Precisando descansar"
