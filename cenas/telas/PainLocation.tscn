[gd_scene format=3]

[ext_resource type="FontVariation" path="res://fontes/Body.tres" id="1"]
[ext_resource type="FontVariation" path="res://fontes/Heading.tres" id="2"]
[ext_resource type="FontVariation" path="res://fontes/Medium.tres" id="3"]
[ext_resource type="Script" path="res://scripts/pain_location.gd" id="4"]
[ext_resource type="Texture2D" path="res://recursos/ui/arrow-left.svg" id="5"]
[ext_resource type="Texture2D" path="res://recursos/ui/accessibility.svg" id="6"]
[ext_resource type="PackedScene" path="res://cenas/componentes/FeelingsCard.tscn" id="7"]
[ext_resource type="Texture2D" path="res://recursos/corpo/cabeca.svg" id="8"]
[ext_resource type="Texture2D" path="res://recursos/corpo/barriga.svg" id="9"]
[ext_resource type="Texture2D" path="res://recursos/corpo/peito.svg" id="10"]
