[ext_resource type="Texture2D" path="res://recursos/corpo/garganta.svg" id="13"]

[node name="PainLocation" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("4")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.98039, 0.96863, 0.94902, 1)

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
theme_override_constants/margin_left = 56
theme_override_constants/margin_top = 56
theme_override_constants/margin_right = 56
theme_override_constants/margin_bottom = 56
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 28

[node name="Header" type="HBoxContainer" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="BackButton" type="Button" parent="MarginContainer/Content/Header"]
layout_mode = 2
custom_minimum_size = Vector2(100, 100)
text = ""
theme_override_font_sizes/font_size = 38
icon = ExtResource("5")
expand_icon = true
theme_override_constants/icon_max_width = 42
theme_override_constants/h_separation = 20

[node name="Title" type="Label" parent="MarginContainer/Content/Header"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 34
theme_override_colors/font_color = Color(0.18824, 0.14902, 0.24706, 1)
text = "LOCAL DA DOR"
mouse_filter = 2
size_flags_horizontal = 3
vertical_alignment = 1
horizontal_alignment = 1

[node name="AcessibilityButton" type="Button" parent="MarginContainer/Content/Header"]
layout_mode = 2
custom_minimum_size = Vector2(100, 100)
text = ""
theme_override_font_sizes/font_size = 38
icon = ExtResource("6")
expand_icon = true
theme_override_constants/icon_max_width = 42
theme_override_constants/h_separation = 20

[node name="Step" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 26
theme_override_colors/font_color = Color(0.48235, 0.35294, 0.7098, 1)
text = "VAMOS LOCALIZAR"
mouse_filter = 2

[node name="Subtitle" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 70
theme_override_colors/font_color = Color(0.18824, 0.14902, 0.24706, 1)
text = "Onde está doendo?"
mouse_filter = 2
autowrap_mode = 2
size_flags_horizontal = 3

[node name="Helper" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_fonts/font = ExtResource("1")
theme_override_font_sizes/font_size = 32
theme_override_colors/font_color = Color(0.45882, 0.40784, 0.50196, 1)
text = "Toque na região que você quer mostrar."
mouse_filter = 2
autowrap_mode = 2
size_flags_horizontal = 3

[node name="FeelingsGrid" type="GridContainer" parent="MarginContainer/Content"]
layout_mode = 2
size_flags_vertical = 3
columns = 2
theme_override_constants/h_separation = 24
theme_override_constants/v_separation = 24

